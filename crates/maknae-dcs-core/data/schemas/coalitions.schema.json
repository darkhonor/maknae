{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coalition tetragraph registry",
  "description": "Maps coalition tetragraphs to their member nation trigraphs. The engine decomposes a REL-TO tetragraph to this member set in-memory (expand-or-deny, #26); an unregistered tetragraph grants nothing (Deny). Every member is cross-validated against the ISO-3166 nations registry at build time; a malformed member FAILS THE BUILD (D2).",
  "type": "object",
  "required": ["version", "source", "coalitions"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "coalitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tetragraph", "members", "source", "effective_date"],
        "additionalProperties": false,
        "properties": {
          "tetragraph": { "type": "string", "pattern": "^[A-Z]{4}$" },
          "members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
          },
          "source": { "type": "string", "minLength": 1 },
          "effective_date": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
