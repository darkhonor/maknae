#!/usr/bin/env bash
# Opt-in via git config core.hooksPath ci/hooks. Package selection compares the
# actual ref update, including pushes to remotes other than origin, never a guessed base.
# MAKNAE_PRE_PUSH_MUTANTS=1 additionally runs diff-only mutation over the
# selected packages; a new ref's base is <remote>/HEAD or MAKNAE_PRE_PUSH_MUTANTS_BASE.
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_LITERAL_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_GLOB_PATHSPECS GIT_ICASE_PATHSPECS
root="$(env -u GIT_DIR -u GIT_WORK_TREE git rev-parse --show-toplevel)"
selection="$(mktemp "${TMPDIR:-/tmp}/maknae-push.XXXXXXXX")"
trap 'rm -f "$selection"' EXIT
build=0
mutation_bases=()
mutation_packages=()
checked_docs=0
while read -r local_ref local_oid _remote_ref remote_oid; do
  # Deleting a ref introduces no code. New refs have an all-zero remote oid;
  # the selector widens those to full checks because history is unavailable.
  [[ "$local_oid" =~ ^0+$ ]] && continue
  base="$remote_oid"
  if [ "$local_oid" != "$(git -C "$root" rev-parse HEAD)" ]; then
    # Gate runs in this checkout, so it cannot attest to another ref's content.
    echo "FAIL: pre-push checks require checking out $local_ref first" >&2
    exit 1
  fi
  # Documentation updates still have live contracts to validate. Match CI's
  # lightweight lane once per push, before deciding whether Rust is affected.
  if [ "$checked_docs" = 0 ]; then
    bash "$root/ci/gates/external-authority-lint.sh"
    bash "$root/ci/gates/isolation-contract-lint.sh" "$root"
    checked_docs=1
  fi
  python3 "$root/ci/affected.py" --root "$root" --event push \
    --base="$base" --head="$local_oid" >"$selection"
  cat "$selection"
  if python3 -c 'import json,sys; sys.exit(not json.load(open(sys.argv[1]))["build"])' "$selection"; then
    build=1
  fi
  selected="$(python3 -c 'import json,sys; print(" ".join(json.load(open(sys.argv[1]))["mutants"]))' "$selection")"
  if [ "${MAKNAE_PRE_PUSH_MUTANTS:-0}" = 1 ] && [ -n "${selected// /}" ]; then
    if [ -n "${MAKNAE_PRE_PUSH_MUTANTS_BASE:-}" ]; then
      diff_base="$MAKNAE_PRE_PUSH_MUTANTS_BASE"
    elif [[ "$remote_oid" =~ ^0+$ ]]; then
      if ! diff_base="$(git -C "$root" rev-parse --verify --quiet "refs/remotes/${1-}/HEAD")"; then
        echo "FAIL: pre-push: new ref $local_ref has no base; set MAKNAE_PRE_PUSH_MUTANTS_BASE=<rev>" >&2
        exit 1
      fi
    else
      diff_base="$remote_oid"
    fi
    python3 "$root/ci/affected.py" --root "$root" --event pull_request \
      --base="$diff_base" --head="$local_oid" >"$selection"
    selected="$(python3 -c 'import json,sys; print(" ".join(json.load(open(sys.argv[1]))["mutants"]))' "$selection")"
    if [ -n "${selected// /}" ]; then
      mutation_bases+=("$diff_base")
      mutation_packages+=("$selected")
    fi
  fi
done
if [ "$build" = 1 ]; then
  bash "$root/ci/gates/unsafe-confinement.sh" --root "$root"
  bash "$root/ci/gates/coverage-tiers.sh" --root "$root"
  # MAKNAE_PRE_PUSH_LINUX_CLIPPY=1 additionally runs the Linux clippy lane in a
  # container (#74). Opt-in and OFF by default, like MAKNAE_PRE_PUSH_MUTANTS:
  # a cold run pulls an image and installs cmake+go, which is not a cost to put
  # on every push. REQUIRE is set with it so a missing container engine is a
  # hard failure here rather than a SKIP -- an opt-in that silently skips is
  # worse than no opt-in, because the contributor believes the lane ran.
  if [ "${MAKNAE_PRE_PUSH_LINUX_CLIPPY:-0}" = 1 ]; then
    MAKNAE_REQUIRE_LINUX_CLIPPY=1 bash "$root/ci/gates/clippy-all.sh" --root "$root" --linux
  fi
  i=0
  while [ "$i" -lt "${#mutation_bases[@]}" ]; do
    read -r -a packages <<< "${mutation_packages[$i]}"
    bash "$root/ci/gates/coverage-tiers.sh" --root "$root" --mutants "${packages[@]}" \
      --in-diff "${mutation_bases[$i]}" </dev/null
    i=$((i + 1))
  done
else
  echo "SKIP: documentation-only updates (or ref deletions)"
fi
