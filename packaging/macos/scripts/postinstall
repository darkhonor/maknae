#!/bin/bash
# maknae postinstall — config lifecycle, the audit sink, and the disabled default.
set -euo pipefail

DEFAULTS="/usr/local/share/maknae/defaults"
ETC="/etc/maknae"
AUDIT="/var/log/maknae/audit.jsonl"
LABEL="io.maknae.maknaed"
RECEIPT="/usr/local/var/db/maknae/install-receipt.plist"

# NUMERIC ids. `install: unknown group <name>` exits 1 and this script runs under
# `set -e`, so a name lookup that misses the opendirectoryd cache seconds after
# preinstall's dscl -create would abort the whole install.
MUID="$(plutil -extract MaknaeUID raw -o - "$RECEIPT" 2>/dev/null || echo 0)"
MGID="$(plutil -extract MaknaeGID raw -o - "$RECEIPT" 2>/dev/null || echo 0)"

# --- config: FIRST-INSTALL-ONLY, the conffile equivalent ---------------------
# macOS has no dpkg `conffiles` / rpm `%config(noreplace)`. A .pkg payload ALWAYS
# overwrites, so the shipped defaults are staged OUTSIDE /etc and copied in only
# when absent. `maknae enroll` rewrites maknae.yaml in place with the real
# deployment id, vault addr, transport.socket_path and the principal block
# (bins/maknae/src/enroll/mod.rs, build_daemon_yaml); authz.yaml carries the operator's DAC
# policy. Overwriting either on upgrade would silently de-enroll the host.
# FAIL CLOSED on the load-bearing controls (PR #287 review, blocking finding 2).
# The original form wrapped every ownership/mode repair and both chflags calls in
# `2>/dev/null || :` with NO verification, so a failed chown could leave the daemon
# unable to read its config, and a failed `chflags uappnd` would silently remove
# the append-only audit protection the isolation contract CLAIMS with a check —
# while the installer still reported success. preinstall already verifies its
# load-bearing runtime-directory row (BSD `install -d` returns 0 even when its
# chown fails); this applies the same discipline here.
verify() {   # $1=what  $2=expected  $3=actual
    [ "$2" = "$3" ] || {
        echo "maknae: $1 — expected '$2', got '$3'" >&2
        echo "  Refusing to report a successful install with this control unestablished." >&2
        exit 1
    }
}

# Root-owned 0700 with no ACL, verified; on failure the directory is left root-held.
hold_dir() {
    [ -d "$1" ] && [ ! -L "$1" ] || return 1
    chown 0:0 "$1" && chmod -N "$1" && chmod 0700 "$1" || return 1
    [ "$(stat -f '%u %g %Lp' "$1")" = "0 0 700" ] && [ "$(ls -led "$1" | wc -l)" -eq 1 ]
}

# The search entry for each reader maknae.yaml declares (#500), restored after the
# hold strips the directory's ACL. The trail files' own entries are never touched here.
grant_reader_traverse() {
    local readers r errf rc=0
    errf="$(mktemp)" || return 1
    if ! readers="$(/usr/local/bin/maknae audit-readers 2>"$errf")"; then
        echo "maknae: audit.readers not applied: $(cat "$errf")" >&2
        rm -f "$errf"
        return 0
    fi
    rm -f "$errf"
    [ -n "$readers" ] || return 0
    printf '%s\n' "$readers" | LC_ALL=C grep -Evx '[a-z_][a-z0-9_-]{0,30}[$]?' >/dev/null || rc=$?
    if [ "$rc" -ne 1 ]; then
        echo "maknae: audit.readers printed an unexpected name; not applied" >&2
        return 0
    fi
    for r in $readers; do chmod +a "user:$r allow search" /var/log/maknae || return 1; done
}

# --- DISABLED by default, on a FRESH INSTALL ONLY ---------------------------
# `man launchd` FILES: /Library/LaunchDaemons = "System-wide daemons provided by
# the administrator" — it is SCANNED AT BOOT. Merely declining to `bootstrap` is
# therefore NOT the macOS equivalent of the rpm's preset-disabled default: with
# RunAtLoad + KeepAlive{SuccessfulExit:false} and no StartLimitBurst equivalent, a
# fresh UNENROLLED install would become a permanent 5-second respawn loop from the
# next reboot. `launchctl disable` writes the external disabled database
# (launchd.plist(5) Disabled: "this state is kept externally"), which survives
# reboot and is reversed by `launchctl enable`.
#
# FRESH ONLY. packaging/deb/postinst:64-80 draws exactly this line: "DO NOT
# auto-enable or start on fresh install", then "On UPGRADE ... restart ONLY if the
# daemon was running ... PRESERVING the operator's enabled/running state."
# Disabling unconditionally would write a reboot-surviving disable on every
# upgrade, so an enrolled, enabled, running host would keep serving until its next
# reboot and then silently never start again.
#
# Operator flow: install -> `sudo maknae enroll` ->
# `sudo launchctl enable system/io.maknae.maknaed` ->
# `sudo launchctl bootstrap system /Library/LaunchDaemons/io.maknae.maknaed.plist`.
KIND_FILE="/usr/local/var/db/maknae/.install-kind"
KIND="$(sed -n 1p "$KIND_FILE" 2>/dev/null || echo fresh)"
WAS_LOADED="$(sed -n 2p "$KIND_FILE" 2>/dev/null || echo false)"
EGRESS_WAS_LOADED="$(sed -n 3p "$KIND_FILE" 2>/dev/null || echo false)"
EGRESS_PLIST_EXISTED="$(sed -n 4p "$KIND_FILE" 2>/dev/null || echo false)"
SYNC_PLIST_EXISTED="$(sed -n 5p "$KIND_FILE" 2>/dev/null || echo false)"
rm -f "$KIND_FILE"
disabled_state() {
    case "$(launchctl print-disabled system 2>/dev/null)" in
        *"\"$1\" => disabled"*) echo disabled ;;
        *) echo "not disabled" ;;
    esac
}
DISABLE_MAKNAED=false; DISABLE_EGRESS=false; DISABLE_SYNC=false
if [ "$KIND" = "fresh" ]; then DISABLE_MAKNAED=true; fi
# The deputy follows the same rule, and is also disabled on an upgrade from a
# package that did not ship it: its plist is new in /Library/LaunchDaemons and
# would otherwise start, unenrolled, at the next boot.
EGRESS_LABEL="io.maknae.maknae-egress"
if [ "$KIND" = "fresh" ] || [ "$EGRESS_PLIST_EXISTED" != "true" ]; then
    DISABLE_EGRESS=true
fi
SYNC_LABEL="io.maknae.policy-sync"
if [ "$KIND" = "fresh" ] || [ "$SYNC_PLIST_EXISTED" != "true" ]; then
    DISABLE_SYNC=true
fi
[ "$DISABLE_MAKNAED" = false ] || launchctl disable "system/$LABEL" 2>/dev/null || :
[ "$DISABLE_EGRESS" = false ] || launchctl disable "system/$EGRESS_LABEL" 2>/dev/null || :
[ "$DISABLE_SYNC" = false ] || launchctl disable "system/$SYNC_LABEL" 2>/dev/null || :
[ "$DISABLE_MAKNAED" = false ] || verify "launchctl disable $LABEL" disabled "$(disabled_state "$LABEL")"
[ "$DISABLE_EGRESS" = false ] || verify "launchctl disable $EGRESS_LABEL" disabled "$(disabled_state "$EGRESS_LABEL")"
[ "$DISABLE_SYNC" = false ] || verify "launchctl disable $SYNC_LABEL" disabled "$(disabled_state "$SYNC_LABEL")"

install -d -m 0750 -o 0 -g "$MGID" "$ETC"
for f in authz.yaml maknae.yaml; do
    if [ ! -e "$ETC/$f" ]; then
        install -m 0640 -o 0 -g "$MGID" "$DEFAULTS/$f" "$ETC/$f"
    fi
done
# Fresh install only (no store yet): a bindings.yaml root removed stays removed;
# maknaed keeps enforcing the bindings it holds and `maknae policy sync` restores the file.
CONFIGS=("$ETC/authz.yaml" "$ETC/maknae.yaml")
if [ -e "$ETC/bindings.yaml" ] || [ -h "$ETC/bindings.yaml" ]; then
    CONFIGS+=("$ETC/bindings.yaml")
elif [ ! -e "/usr/local/var/db/maknae/state/kernel.graph" ]; then
    install -m 0640 -o 0 -g "$MGID" "$DEFAULTS/bindings.yaml" "$ETC/bindings.yaml"
    CONFIGS+=("$ETC/bindings.yaml")
else
    echo "maknae: $ETC/bindings.yaml is absent and a kernel graph store exists; it is left absent" >&2
fi
# Re-assert ownership on EVERY install: the loader fail-closes on any world bit,
# and the daemon runs as _maknae and needs group-read (root:_maknae 0640, spec
# §4.6 — the rpm gets this from %attr).
chown "0:$MGID" "$ETC" "$ETC/private" 2>/dev/null || :
chmod 0750      "$ETC" "$ETC/private" 2>/dev/null || :
chown "0:$MGID" "${CONFIGS[@]}" 2>/dev/null || :
chmod 0640      "${CONFIGS[@]}" 2>/dev/null || :
# VERIFY the end state rather than trusting the calls. If the daemon cannot read
# its own config it fails closed at boot with no useful diagnostic, so a wrong
# mode here surfaces as a mysterious runtime refusal rather than an install error.
for d in "$ETC" "$ETC/private"; do
    verify "$d ownership/mode" "0 $MGID 750" "$(stat -f '%u %g %Lp' "$d")"
done
for f in "${CONFIGS[@]}"; do
    verify "$f ownership/mode" "0 $MGID 640" "$(stat -f '%u %g %Lp' "$f")"
done

# --- audit sink -------------------------------------------------------------
# Root holds the directory while it acts on the entry; a refusal leaves it held.
hold_dir /var/log/maknae || { echo "maknae: cannot hold /var/log/maknae as root 0700 with no ACL; it is left root-owned" >&2; exit 1; }
if [ -L "$AUDIT" ] || { [ -e "$AUDIT" ] && { [ ! -f "$AUDIT" ] || [ "$(stat -f %l "$AUDIT")" != 1 ]; }; }; then
    echo "maknae: $AUDIT is not a regular, single-link file; /var/log/maknae is left root-owned" >&2
    exit 1
fi
if [ ! -e "$AUDIT" ]; then
    install -m 0640 -o "$MUID" -g "$MGID" /dev/null "$AUDIT"
elif [ "$(stat -f '%u %g %Lp' "$AUDIT")" != "$MUID $MGID 640" ]; then
    # A RETAINED trail from a previous install (uninstall.sh keeps /var/log/maknae
    # deliberately) carries the OLD numeric owner, and ids are allocated
    # dynamically (D8) so a reinstall can hand out different ones. Left alone, the
    # daemon fails closed on audit open. Clear append-only, re-own, re-set, and
    # never with a writer running.
    if [ "$WAS_LOADED" = "true" ]; then
        echo "maknae: $AUDIT needs re-owning while $LABEL is loaded; /var/log/maknae is left root-owned" >&2
        exit 1
    fi
    chflags nouappnd "$AUDIT" 2>/dev/null || :
    chown "$MUID:$MGID" "$AUDIT" 2>/dev/null || :
    chmod 0640 "$AUDIT" 2>/dev/null || :
fi
# Append-only at the FILE level only — never the directory (a +a dir blocks the
# installer from managing /var/log/maknae on upgrade, the same reason the Linux
# packaging refuses it).
chflags uappnd "$AUDIT" 2>/dev/null || :

# VERIFY ownership/mode AND that the append-only flag actually took. The isolation
# contract's macOS "Audit protection" row claims `chflags uappnd` with a check; a
# silently-failed chflags makes that claim false while the install reports success,
# which is precisely the fail-open class this project refuses elsewhere.
verify "$AUDIT ownership/mode" "$MUID $MGID 640" "$(stat -f '%u %g %Lp' "$AUDIT")"
case "$(stat -f '%Sf' "$AUDIT")" in
    *uappnd*) : ;;
    *) echo "maknae: $AUDIT is not append-only (flags: '$(stat -f '%Sf' "$AUDIT")')" >&2
       echo "  The isolation contract claims chflags uappnd as the macOS audit-protection" >&2
       echo "  control. Refusing to report a successful install without it." >&2
       exit 1 ;;
esac
if ! grant_reader_traverse; then
    echo "maknae: cannot apply audit.readers to /var/log/maknae; it is left root-owned" >&2
    exit 1
fi
chown -h "$MUID:$MGID" /var/log/maknae
verify "/var/log/maknae ownership/mode" "$MUID $MGID 700" "$(stat -f '%u %g %Lp' /var/log/maknae)"

# --- kernel graph store ------------------------------------------------------
# A reinstall can renumber _maknae, leaving a retained store owned by a uid with no
# account. Root holds the directory while those entries are re-owned, so the
# daemon account cannot swap a name for a link to a root file between check and chown.
STATE="/usr/local/var/db/maknae/state"
install -d -m 0700 -o "$MUID" -g "$MGID" "$STATE"
if [ -n "$(find "$STATE" -xdev -mindepth 1 -maxdepth 1 -nouser -print -quit)" ]; then
    hold_dir "$STATE" || { echo "maknae: cannot hold $STATE as root 0700 with no ACL; it is left root-owned" >&2; exit 1; }
    find "$STATE" -xdev -mindepth 1 -maxdepth 1 -type f -links 1 -nouser \
        -exec chown -h "$MUID:$MGID" {} +
    chown "$MUID:$MGID" "$STATE"
fi
chmod 0700 "$STATE"
verify "$STATE ownership/mode" "$MUID $MGID 700" "$(stat -f '%u %g %Lp' "$STATE")"

if [ "$DISABLE_MAKNAED" = false ] && [ "$WAS_LOADED" = "true" ]; then
    # Upgrade of a running daemon: the payload replaced the file but the live
    # process still holds the old inode. Restart it onto the new binary, exactly as
    # the deb's `systemctl try-restart` does.
    launchctl kickstart -k "system/$LABEL" || {
        echo "maknae: could not restart $LABEL onto the new binary — the old process may still be running" >&2
        exit 1
    }
fi
if [ "$DISABLE_EGRESS" = false ] && [ "$EGRESS_WAS_LOADED" = "true" ]; then
    launchctl kickstart -k "system/$EGRESS_LABEL" || {
        echo "maknae: could not restart $EGRESS_LABEL onto the new binary — the old process may still be running" >&2
        exit 1
    }
fi

exit 0
