#!/bin/bash
# maknae prerm — mirrors the rpm %preun teardown, AppArmor edition.
set -e

# The profile is unloaded only once no instance runs, so none is left unconfined.
stop_agent_instances() {
    local rc=0 units left
    units="$(systemctl list-units --plain --no-legend 'maknae-agent@*.service')" || rc=1
    units="$(printf '%s\n' "$units" | awk '{for (i = 1; i <= NF; i++) if ($i ~ /^maknae-agent@/) {printf "%s%s", s, $i; s=" "; break}}')"
    printf '%s\n' "$units" | xargs -r systemctl stop || rc=1
    left="$(systemctl list-units --plain --no-legend --state=active,activating,deactivating,reloading 'maknae-agent@*.service')" || rc=1
    left="$(printf '%s\n' "$left" | awk '{for (i = 1; i <= NF; i++) if ($i ~ /^maknae-agent@/) {printf "%s%s", s, $i; s=" "; break}}')"
    [ "$rc" -eq 0 ] && [ -z "$left" ] && return 0
    echo "maknae: the Agent Daemon did not stop (${left:-${units:-its instances could not be listed}}); removal is aborted and the maknae-agentd AppArmor profile stays loaded" >&2
    return 1
}

case "$1" in
    remove)
        # Stop before unconfining. The audit trail and its append-only attribute
        # are kept until purge.
        stop_agent_instances || exit 1
        systemctl stop maknae-policy-sync.path maknae-policy-sync.service 2>/dev/null || :
        systemctl disable maknae-policy-sync.path maknae-policy-sync.service 2>/dev/null || :
        systemctl stop maknaed.service 2>/dev/null || :
        systemctl disable maknaed.service 2>/dev/null || :
        systemctl stop maknae-egress.service maknae-egress.socket 2>/dev/null || :
        systemctl disable maknae-egress.service maknae-egress.socket 2>/dev/null || :
        if command -v apparmor_parser >/dev/null 2>&1; then
            apparmor_parser -R /etc/apparmor.d/usr.bin.maknaed 2>/dev/null || :
            apparmor_parser -R /etc/apparmor.d/usr.bin.maknae-egress 2>/dev/null || :
            apparmor_parser -R /etc/apparmor.d/usr.bin.maknae-agentd 2>/dev/null || :
        fi
        ;;
    upgrade)
        # Upgrade: DO NOT stop or disable — a running, operator-enabled daemon
        # must survive the upgrade (postinst try-restarts it onto the new binary
        # and preserves its enabled state). audit.jsonl is script-created, not
        # payload, so dpkg does not replace it. The AppArmor profile is reloaded
        # by the new postinst.
        :
        ;;
esac

#DEBHELPER#

exit 0
