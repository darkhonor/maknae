#!/bin/bash
# maknae postrm — mirrors the rpm removal cleanup.
set -e

case "$1" in
    purge)
        # rm cannot unlink an append-only inode. The directory is root-held while
        # root acts on its entry; a symlink is unlinked by rm without clearing.
        AUDIT=/var/log/maknae/audit.jsonl
        if [ -d /var/log/maknae ] && [ ! -h /var/log/maknae ]; then
            chown root:root /var/log/maknae
            chattr -a /var/log/maknae 2>/dev/null || :
            if [ -f "$AUDIT" ] && [ ! -h "$AUDIT" ]; then
                if [ "$(stat -c %h "$AUDIT")" = 1 ]; then
                    chattr -a "$AUDIT" 2>/dev/null || :
                else
                    echo "maknae: $AUDIT has more than one link; append-only not cleared" >&2
                fi
            fi
        fi

        # Remove configuration, the audit trail and the kernel graph store on
        # purge only.
        rm -rf /etc/maknae
        rm -rf /etc/ssl/maknae
        rm -rf /var/log/maknae
        rm -rf /var/lib/maknae

        systemctl daemon-reload 2>/dev/null || :
        ;;

    remove)
        systemctl daemon-reload 2>/dev/null || :
        ;;
esac

#DEBHELPER#

exit 0
