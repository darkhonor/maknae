#!/bin/bash
# maknae postrm — mirrors the rpm removal cleanup.
set -e

case "$1" in
    purge)
        # rm cannot unlink an append-only inode, and archived trails carry the
        # attribute too. The directory is root-held while root acts on its
        # entries; find -type f never follows a symlink.
        if [ -d /var/log/maknae ] && [ ! -h /var/log/maknae ]; then
            chown root:root /var/log/maknae
            chattr -a /var/log/maknae 2>/dev/null || :
            find /var/log/maknae -xdev -mindepth 1 -maxdepth 1 -type f -links 1 \
                -exec chattr -a {} + 2>/dev/null || :
            if [ -n "$(find /var/log/maknae -xdev -mindepth 1 -maxdepth 1 -type f -links +1 -print -quit)" ]; then
                echo "maknae: a file in /var/log/maknae has more than one link; append-only not cleared" >&2
            fi
        fi

        # Remove configuration, the audit trail and the kernel graph store on
        # purge only.
        rm -rf /etc/maknae
        rm -rf /etc/ssl/maknae
        rm -rf /var/log/maknae
        rm -rf /var/lib/maknae

        systemctl daemon-reload 2>/dev/null || :
        ;;

    remove)
        systemctl daemon-reload 2>/dev/null || :
        ;;
esac

#DEBHELPER#

exit 0
