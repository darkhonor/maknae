# AppArmor profile for maknae-egress (the maknae egress deputy, #240a).
# Install to: /etc/apparmor.d/usr.bin.maknae-egress
# Reload:     apparmor_parser -r /etc/apparmor.d/usr.bin.maknae-egress
#
# AppArmor 3.x syntax (Debian 13 Trixie / Ubuntu 24.04 Noble); 4.0 accepts 3.x.
#
# The Debian analog of maknae_egress_t in packaging/common/maknae.te. This is
# the process that holds the provider credential and is the only one with a
# route out, so its profile is DELIBERATELY NARROWER than maknaed's: no home
# access at all, no audit tree, no policy files.

#include <tunables/global>

profile maknae-egress /usr/bin/maknae-egress {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Binary — map + read.
  /usr/bin/maknae-egress                 mr,

  # The deputy's operating bounds, and NOTHING else under /etc/maknae. It reads
  # no policy, no provider registry and no identity map: the kernel decided all
  # of that long before a frame reached this process. Contrast maknaed, which
  # needs `/etc/maknae/** r` — the narrower grant here is the point.
  /etc/maknae/                           r,
  /etc/maknae/egress-bounds.yaml         r,

  # The decrypted SecretID systemd places in $CREDENTIALS_DIRECTORY (memory
  # backed, 0400, this account only). The SEALED .cred under /etc/maknae/private
  # is deliberately NOT readable here — it is root/systemd's, exactly as the
  # SELinux maknae_secret_t carve-out denies it to maknaed.
  # The DIRECTORY as well as its contents: maknae-io opens the parent
  # O_RDONLY|O_DIRECTORY before the file, and `/dir/**` does not cover
  # `/dir/` itself — the sibling maknaed profile carries both lines too.
  @{run}/credentials/maknae-egress.service/   r,
  @{run}/credentials/maknae-egress.service/** r,

  # Its own socket directory (systemd creates the socket and passes the fd).
  @{run}/maknae-egress/                  r,
  @{run}/maknae-egress/egress.sock       rw,

  # No @{PROC} or cgroup grants, deliberately: the deputy is a current-thread
  # runtime over a std listener that binds nothing, so tokio's somaxconn and
  # cgroup probes (which maknaed's profile grants) are never reached here.
  # An enforcing-host denial would say otherwise; that is #242's to see.

  # #240b: the deputy's own credential set — the RoleID and its copy of the
  # Vault TLS anchor — written by `maknae enroll` as root:_maknae-egress 0640
  # under a 0750 dir. The sealed SecretID stays under /etc/maknae/private,
  # denied below; systemd decrypts it into $CREDENTIALS_DIRECTORY.
  /etc/maknae/egress/                    r,
  /etc/maknae/egress/**                  r,

  # #240b: the two OUTBOUND legs (the inbound one, AF_UNIX, is below).
  # Vault (the AppRole login and the KV read,
  # with /etc/maknae/egress/vault-ca.crt added as an EXTRA trust anchor beside
  # the system store — vaultrs merges, it cannot pin) and the provider
  # (TLS verified against the SYSTEM trust store — reqwest's platform verifier
  # reads the distribution bundle on Linux, which is what abstractions/ssl_certs
  # grants). WHICH endpoint is reached is the kernel's decision over root-owned
  # configuration; the deputy originates nothing — the same division as
  # maknaed's Vault leg.
  network inet stream,
  network inet6 stream,
  #include <abstractions/ssl_certs>
  # And the family the deputy is BUILT on: it accepts on the systemd-passed
  # AF_UNIX fd, reads, writes and captures peer credentials there. Stated
  # explicitly rather than left to abstractions/base and parser defaults,
  # as the unit's RestrictAddressFamilies and the SELinux module state it.
  # Whether these lines are LOAD-BEARING under enforcement — i.e. whether a
  # profile with inet rules and no unix rule denies AF_UNIX on a given
  # kernel — is #242's to measure on the enforcing host; the sibling maknaed
  # profile carries the same two lines for the same reason. Both spellings,
  # for kernels with and without fine-grained unix mediation.
  network unix stream,
  unix (create, bind, listen, accept, connect, send, receive, getattr, setopt, getopt, shutdown) type=stream,

  # Explicitly denied, so the intent is legible rather than merely absent:
  # the deputy never reads user files and never touches the audit trail.
  deny @{HOME}/** rwklx,
  deny /home/** rwklx,
  deny /var/log/maknae/** rwklx,
  deny /etc/maknae/private/** rwklx,
  deny /etc/maknae/authz.yaml rwklx,
}
