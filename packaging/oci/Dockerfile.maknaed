# Maknae maknaed image (spec §6). SCAFFOLD STUB.
# Static musl target so the FROM scratch stage (no libc/loader) can actually run the binary.
# Base pinned by DIGEST, not tag (supply-chain: a tag can be re-pointed, a digest
# cannot). The tag is a label for humans; Dependabot's docker ecosystem moves both.
# The image's rustup honors rust-toolchain.toml from the COPY, so the toolchain that
# builds is the pinned 1.99.1, whatever the base carries.
FROM rust:1.99.1@sha256:931c2c0531a8b143e044f0f3914dfe802f15bb3d1955f0b657e9359327ac2ffc AS build
WORKDIR /src
COPY . .
RUN rustup target add x86_64-unknown-linux-musl && cargo install cargo-auditable --locked
# single-package AUDITABLE static build (spec §3 build-invocation discipline + §6 inventory + musl)
RUN cargo auditable build -p maknaed --release --target x86_64-unknown-linux-musl
FROM scratch
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/maknaed /maknaed
ENTRYPOINT ["/maknaed"]
