policy_module(maknae, 1.0.0)

########################################
# Type declarations
########################################

# Process domain — maknaed runs here (entered from maknaed_exec_t).
type maknaed_t;
type maknaed_exec_t;
init_daemon_domain(maknaed_t, maknaed_exec_t)

# NoNewPrivileges=yes is set in maknaed.service. Under NNP the kernel requires
# the init_t -> maknaed_t transition to be permitted via
# process2:{nnp_transition,nosuid_transition}; without this the transition is
# refused (SELINUX_ERR security_bounded_transition), the daemon runs in init_t,
# and fails on the first append into /var/log/maknae/. Do NOT use `typebounds`
# (it strips maknaed_t's entrypoint on maknaed_exec_t -> status=203/EXEC).
gen_require(`
    type init_t;
')
allow init_t maknaed_t:process2 { nnp_transition nosuid_transition };

# #240a: the egress deputy. Its own domain, entered from its own entrypoint —
# the process that holds the provider credential and the only route out must
# not share maknaed_t.
type maknae_egress_t;
type maknae_egress_exec_t;
init_daemon_domain(maknae_egress_t, maknae_egress_exec_t)
# maknae-egress.service ALSO sets NoNewPrivileges=yes, so it needs the same
# process2 permission for the same reason as maknaed above: without it the
# transition is refused (SELINUX_ERR security_bounded_transition) and the
# deputy runs in init_t. And the SAME prohibition applies — do NOT use
# `typebounds` to express the containment relationship; it strips the domain's
# entrypoint on its exec type and yields status=203/EXEC.
allow init_t maknae_egress_t:process2 { nnp_transition nosuid_transition };

# The deputy's operating bounds (/etc/maknae/egress-bounds.yaml) get their OWN
# type, carved out of the maknae_etc_t wildcard by a more-specific .fc rule.
#
# COPY THE .cred RULE'S SHAPE, NEVER ITS GRANTS. That carve-out exists so
# maknaed_t is granted NO access; this one exists so maknae_egress_t is granted
# SOME. BOTH daemons read this file — maknaed validates every registered
# key_vault_path against the prefix at boot, the deputy validates the frame's
# at use — so both are allowed below. Omitting maknaed_t's grant would make the
# daemon refuse to boot on an enforcing host, since its boot gate reads this.
type maknae_egress_bounds_t;
files_config_file(maknae_egress_bounds_t)

# #240b: the deputy's credential dir (/etc/maknae/egress: its RoleID and its
# copy of the Vault TLS anchor). Its own type, so the grant is by TYPE and the
# maknae_etc_t wildcard (maknae.yaml, maknaed-approle-id, tls/) stays
# unreadable to the deputy. The sealed SecretID is maknae_secret_t and stays
# neverallow'd below; systemd decrypts it into $CREDENTIALS_DIRECTORY.
type maknae_egress_etc_t;
files_config_file(maknae_egress_etc_t)

# Config (/etc/maknae) + private (/etc/maknae/private) + audit (/var/log/maknae)
# + runtime (/run/maknae) types.
type maknae_etc_t;
files_config_file(maknae_etc_t)
type maknae_private_t;
files_config_file(maknae_private_t)
# Root/systemd-ONLY secrets under /etc/maknae/private: the sealed *.cred (read by
# systemd/init_t for LoadCredentialEncrypted=, never by the daemon) and
# enroll-state.yaml (accessor record, read by enroll/root only). maknaed_t is
# deliberately granted NO access to this type — SELinux defense-in-depth beyond
# the DAC 0400 root:root modes, so a compromised daemon still cannot read the
# crown-jewel credential or the accessor record.
type maknae_secret_t;
files_type(maknae_secret_t)
type maknae_audit_t;
logging_log_file(maknae_audit_t)
type maknae_runtime_t;
files_pid_file(maknae_runtime_t)

# Operator-labeled Vault port (namespaced — HashiCorp Vault ships no SELinux
# type; a bare vault_port_t would collide with any future community policy).
type maknae_vault_port_t;
corenet_port(maknae_vault_port_t)

# Tool domain — structure-now: the TYPE is declared, compiled, and loaded so the
# exec increment can wire transitions into it later. The automatic
# `domain_auto_trans(maknaed_t, bin_t, maknae_tool_t)` is DEFERRED to that
# increment on purpose: (1) it would fire on ANY bin_t exec — but maknaed spawns
# no subprocess this cycle, so an auto-transition into a near-empty domain could
# only break things; (2) it requires pulling in bin_t. Declaring the domain now
# keeps the structure without the live risk (plan Task 5; reviewer-flagged).
type maknae_tool_t;
domain_type(maknae_tool_t)

########################################
# Policy rules
########################################

# Self-exec
allow maknaed_t maknaed_exec_t:file { read execute execute_no_trans open getattr };

# Read config + private (posture marker + degraded path; the ENCRYPTED .cred is
# read by init_t, NOT here — this grants only the daemon-read artifacts).
allow maknaed_t maknae_etc_t:dir { open read search getattr };
allow maknaed_t maknae_etc_t:file { read open getattr };
# #240a: both readers of the bounds file, by type.
allow maknaed_t maknae_egress_bounds_t:file { read open getattr };
allow maknae_egress_t maknae_egress_bounds_t:file { read open getattr };
allow maknae_egress_t maknae_etc_t:dir { open read search getattr };
allow maknae_egress_t maknae_egress_etc_t:dir { open read search getattr };
# maknaed enumerates /etc/maknae at boot; on a filesystem without d_type it
# stats each entry, so it needs getattr (and only that) on the deputy's dir.
allow maknaed_t maknae_egress_etc_t:dir { getattr search };
allow maknae_egress_t maknae_egress_etc_t:file { read open getattr };
# The deputy's own entrypoint.
allow maknae_egress_t maknae_egress_exec_t:file { read execute execute_no_trans open getattr };
# #240b: the decrypted SecretID in $CREDENTIALS_DIRECTORY — the same label
# split as maknaed's (el10 init_var_run_t, el9 tmpfs_t; see the maknaed block
# below for the probe that established it). Required here as well as there:
# checkmodule is single-pass, and this block comes first in the file.
gen_require(`
    type var_run_t;
    type init_var_run_t;
    type tmpfs_t;
')
allow maknae_egress_t var_run_t:dir { search getattr open read };
allow maknae_egress_t init_var_run_t:dir { search getattr open read };
allow maknae_egress_t init_var_run_t:file { read open getattr };
allow maknae_egress_t tmpfs_t:file { read open getattr };
# #240b: the two network legs. Vault: the SAME operator-labeled port as
# maknaed (maknae_vault_port_t, maknae-selinux-ports.sh). Provider:
# corenet_tcp_connect_http_port.
#
# CORRECTED 2026-09-14. The #240a comment here promised the provider leg "a
# dedicated labeled port type plus name_connect, never a blanket
# corenet_tcp_connect_*_port". That is not expressible for the port every
# provider listens on: tcp/443 is http_port_t in base policy, and the shipped
# ports helper refuses (by design) to relabel a foreign label. The interface
# is therefore the narrowest grant the policy language offers for 443; WHICH
# endpoint is reached is decided by the kernel over root-owned configuration,
# not by the port label. UNVERIFIED on an enforcing host in this change — the
# packaged-Rocky evidence is #242's.
allow maknae_egress_t self:tcp_socket { create connect setopt getopt read write getattr shutdown };
allow maknae_egress_t maknae_vault_port_t:tcp_socket name_connect;
corenet_tcp_connect_http_port(maknae_egress_t)
corenet_tcp_sendrecv_generic_node(maknae_egress_t)
sysnet_dns_name_resolve(maknae_egress_t)
# The provider leg verifies against the system trust store.
miscfiles_read_generic_certs(maknae_egress_t)
# Resolves `_maknae` by name at start (nsswitch); urandom for TLS; the same
# daemon basics maknaed_t carries (tokio + reqwest read /proc and signal).
auth_use_nsswitch(maknae_egress_t)
dev_read_urand(maknae_egress_t)
miscfiles_read_localization(maknae_egress_t)
kernel_read_system_state(maknae_egress_t)
allow maknae_egress_t self:process { signal sigchld };
# The listening socket is NOT bound by the deputy: systemd creates it
# (maknae-egress.socket) and hands the fd over. systemd labels a socket
# unit's listener with the domain its service's entrypoint transitions to
# (socket_determine_selinux_label: maknae_egress_t here), falling back to
# its own init_t when that computation is unavailable; both are granted so
# the accept/read/write on the inherited fd works either way, and #242's
# enforcing-host shakeout drops the one that never fires. The accepted
# connection's socket is the deputy's own. (Corrected 2026-09-15: #240a's
# text said the fd "carries init_t's label" — that is the fallback, not the
# rule; the daemon's connectto grant below names the same two labels.)
allow maknae_egress_t init_t:unix_stream_socket { accept listen getattr getopt setopt read write shutdown };
allow maknae_egress_t self:unix_stream_socket { create accept listen getattr getopt setopt read write shutdown };
# DENIED BY TYPE, not by omission: the deputy never reads the audit trail and
# never touches a user home.
neverallow maknae_egress_t maknae_audit_t:file { read write open };
neverallow maknae_egress_t maknae_secret_t:file { read open };
allow maknaed_t maknae_private_t:dir { open read search getattr };
allow maknaed_t maknae_private_t:file { read open getattr };

# #77 read path (spec D5a, 2026-08-28): READ-ONLY vectors over user homes so
# the PEP's anchored read can open the enrolled home and traverse to targets.
# ADR-0021 D3: the anchored reader opens directories O_RDONLY|O_DIRECTORY, so
# dirs need read, not merely search; /home itself is home_root_t and the
# anchor's parent is opened by path. HONESTY: these are TYPES, not per-user
# labels — the MAC grant is host-wide over confined users' homes; the
# per-user scoping layers are the enroll-set DAC ACL (enrolled home only) and
# the PDP grammar. No write vector exists here at any scope.
gen_require(`
    type home_root_t;
    type user_home_dir_t;
    type user_home_t;
')
allow maknaed_t home_root_t:dir { open read getattr search };
allow maknaed_t user_home_dir_t:dir { open read getattr search };
allow maknaed_t user_home_t:dir { open read getattr search };
allow maknaed_t user_home_t:file { read open getattr };
# #365: receipt of the subject's no-access (O_PATH) descriptors is checked as ioctl; the xperm rules allow only command 0x0000, which no filesystem implements.
allow maknaed_t user_home_t:dir ioctl;
allow maknaed_t user_home_t:file ioctl;
allow maknaed_t user_home_dir_t:dir ioctl;
allowxperm maknaed_t user_home_t:dir ioctl 0x0000;
allowxperm maknaed_t user_home_t:file ioctl 0x0000;
allowxperm maknaed_t user_home_dir_t:dir ioctl 0x0000;
# The anchor's own path may traverse a symlinked home component (spec D5:
# open_anchor_resolved deliberately follows the anchor's ancestors by path) —
# read-only lnk_file vectors so a symlinked /home/<user> does not AVC-deny.
allow maknaed_t home_root_t:lnk_file { read getattr };
allow maknaed_t user_home_dir_t:lnk_file { read getattr };
allow maknaed_t user_home_t:lnk_file { read getattr };

# CRITICAL (maknae-specific; Microkosmos has no analog — it uses EnvironmentFile=):
# LoadCredentialEncrypted= makes systemd DECRYPT the SecretID into a per-service
# ramfs at $CREDENTIALS_DIRECTORY (/run/credentials/maknaed.service/). maknaed_t
# must read that DECRYPTED credential at boot or it can't AppRole-auth.
# EMPIRICALLY CONFIRMED on Rocky 10 (2026-08-17): `systemd_read_credentials` does
# NOT exist in el10/el9 refpolicy (using it fails the .pp build), so grant by
# TYPE. `ls -Z /run/credentials/maknaed.service/`: dir = var_run_t, the decrypted
# credential FILE = init_var_run_t. el9 labels MAY differ — the permissive
# shakeout (acceptance) confirms per target and adjusts.
gen_require(`
    type var_run_t;
    type init_var_run_t;
    type tmpfs_t;
')
allow maknaed_t var_run_t:dir { search getattr open read };
allow maknaed_t init_var_run_t:dir { search getattr open read };
allow maknaed_t init_var_run_t:file { read open getattr };
# el9 vs el10 label split (empirically confirmed 2026-08-17 via an
# `ls -Z /run/credentials/<unit>.service/` probe): el10 labels the decrypted
# credential FILE `init_var_run_t`; RHEL/Rocky 9's older selinux-policy labels it
# `tmpfs_t` (the per-service credentials ramfs). Without this grant the daemon is
# denied reading its own SecretID under enforcement on el9 and can't AppRole-auth.
# (Broader than ideal — tmpfs_t is a common type; narrow when el9 policy exposes a
# credential-specific type, tracked with the systemd_read_credentials follow-up.)
allow maknaed_t tmpfs_t:file { read open getattr };

# systemd (init_t) must read the sealed .cred (maknae_secret_t) to decrypt it via
# LoadCredentialEncrypted= — grant init_t (NOT maknaed_t) that access + dir search.
allow init_t maknae_private_t:dir { search getattr };
allow init_t maknae_secret_t:file { read open getattr };

# Audit dir: APPEND, not write (MAC-enforced append-only). NO `create`/`add_name`
# (the package pre-creates the file). `lock` — the sink
# is single-writer and may flock.
allow maknaed_t maknae_audit_t:dir { open read search getattr };
allow maknaed_t maknae_audit_t:file { read append open getattr lock };

# UDS bind + chgrp in /run/maknae.
# el10's systemd 257 labels the RuntimeDirectory=maknae dir `maknae_runtime_t`
# (from the .fc), so el10 uses the tight grants below. el9's systemd 252 does NOT
# relabel RuntimeDirectory dirs — it creates /run/maknae as `var_run_t` and
# bypasses both the .fc selabel and a type-transition (empirically confirmed on
# Rocky 9 fresh-boot, #101: filetrans had no effect). So on el9 the daemon binds
# its socket in a var_run_t dir and needs the var_run_t grants too. This is
# broader than ideal (var_run_t is a common /run type) — the accepted el9 cost of
# the older selinux-policy; a tighter el9 RuntimeDirectory-labeling mechanism is a
# follow-up. el10 is unaffected (it never creates objects in the bare var_run_t dir).
allow maknaed_t maknae_runtime_t:dir { open read search getattr add_name write remove_name };
allow maknaed_t maknae_runtime_t:sock_file { create setattr getattr unlink };
allow maknaed_t var_run_t:dir { add_name write remove_name };
allow maknaed_t var_run_t:sock_file { create setattr getattr unlink };
allow maknaed_t self:unix_stream_socket { create bind listen accept connect read write getattr setopt getopt shutdown connectto };
# #240: the daemon is the CLIENT of the deputy's activation socket
# (/run/maknae-egress/egress.sock — maknae_runtime_t by the .fc, in a dir the
# grant above already lets it search). A connect is `write` on the sock_file
# plus `connectto` on the LISTENING socket's label: the label systemd
# computed for maknae-egress.socket from the deputy's entrypoint
# (maknae_egress_t; see the deputy's accept grant) or init_t as the
# fallback. Without these the newly selected SocketEgress is denied before a
# frame is exchanged (found by codex review of #240). What bounds it: the
# only sock_files the daemon may write are maknae_runtime_t ones, so the
# connectto reaches nothing outside /run/maknae and /run/maknae-egress; no
# bind, listen or accept is granted on the deputy's socket.
allow maknaed_t maknae_runtime_t:sock_file write;
allow maknaed_t { maknae_egress_t init_t }:unix_stream_socket connectto;

# #189 journald audit mirror: the appender writes the systemd native journal
# protocol as a DATAGRAM. Nothing above grants unix_dgram_socket at all --
# CONFIRMED against the COMPILED policy on el9, not by grepping this file:
#   sesearch -A -s maknaed_t -t maknaed_t -c unix_dgram_socket   -> empty
# so under enforcement the daemon cannot even create the socket, let alone
# reach journald's.
#
# `logging_send_syslog_msg()` is the refpolicy interface for exactly this. On
# el9 it is `typeattribute $1 syslog_client_type`, and that attribute carries
# (measured with sesearch against a real member domain):
#   allow syslog_client_type self:unix_dgram_socket { create connect write ... };
#   allow syslog_client_type syslogd_t:unix_dgram_socket sendto;
#   allow syslog_client_type devlog_t:sock_file          { append getattr open write };
#   allow syslog_client_type syslogd_var_run_t:sock_file { append getattr open write };
#
# The last line is why the interface is correct here and a hand-rolled devlog_t
# rule would NOT have been: on el9 `/run/systemd/journal/socket` is labeled
# **syslogd_var_run_t**, not devlog_t (`ls -Z` on an el9 test host). Hand-rolling
# would have shipped a rule that misses the real label -- which is the failure
# this file's interface idiom (logging_log_file above) exists to avoid.
#
# Broader than ideal: the attribute also permits a syslogd_t stream connectto,
# which a dgram-only writer does not need. Narrow if refpolicy ever exposes a
# dgram-only journal interface.
logging_send_syslog_msg(maknaed_t)

# Vault egress is MANDATORY for maknae (unlike Microkosmos's opt-in) — the daemon
# cannot function without Vault, so NO boolean. The operative least-privilege
# control is the PORT LABEL: the operator MUST label their Vault port with
# maknae_vault_port_t (shipped helper maknae-selinux-ports.sh). Only the labeled
# port is reachable.
allow maknaed_t self:tcp_socket { create connect setopt getopt read write bind getattr shutdown };
allow maknaed_t maknae_vault_port_t:tcp_socket name_connect;
corenet_tcp_bind_generic_node(maknaed_t)
corenet_tcp_sendrecv_generic_node(maknaed_t)
sysnet_dns_name_resolve(maknaed_t)

# Standard daemon needs
allow maknaed_t self:process { signal sigchld };
miscfiles_read_localization(maknaed_t)
auth_use_nsswitch(maknaed_t)
kernel_read_system_state(maknaed_t)
dev_read_urand(maknaed_t)
