[Unit]
Description=maknae egress deputy (maknae-egress)
Documentation=https://github.com/darkhonor/maknae
Requires=maknae-egress.socket
After=maknae-egress.socket network-online.target
Wants=network-online.target

[Service]
Type=exec
User=_maknae-egress
# Socket-activated: the listening fd arrives via LISTEN_FDS. NO bind path is
# passed — the --bind fallback exists for the hermetic harness and non-systemd
# dev hosts only, and a test asserts this unit carries none.
ExecStart=/usr/bin/maknae-egress
# systemd (root) TPM-decrypts the sealed SecretID into $CREDENTIALS_DIRECTORY
# (0400, _maknae-egress-only, memory-backed). Name pinned: enroll seals
# --name=maknae-egress-secret-id.
LoadCredentialEncrypted=maknae-egress-secret-id:/etc/maknae/private/maknae-egress-secret-id.cred
# #240b: DefaultEnvironment= (system.conf) and `systemctl set-environment` reach
# every unit, and a proxied estate sets HTTPS_PROXY that way as routine practice.
# reqwest honours the proxy variables by default and vaultrs fills VAULT_* from
# the environment; either would move or unverify a leg the kernel decided on.
# SSL_CERT_FILE/SSL_CERT_DIR REPLACE the platform verifier's root store on
# the provider leg (rustls-native-certs; the Vault leg is pinned). The deputy also removes these itself at
# start (maknae_vault::SCRUBBED_ENV, whose test holds this line equal to it
# AND to maknaed.service's copy); this is the
# init-system half.
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy VAULT_ADDR VAULT_TOKEN VAULT_SKIP_VERIFY VAULT_CACERT VAULT_CAPATH VAULT_CLIENT_CERT VAULT_CLIENT_KEY VAULT_NAMESPACE SSL_CERT_FILE SSL_CERT_DIR
# /run/maknae-egress is the SOCKET unit's RuntimeDirectory= (maknae-egress.socket):
# declared here it was removed on every service stop, taking the path of the
# still-listening activation socket with it, and at 0750 under this User= the
# daemon could not traverse it (codex and critical review of #240).

# maknaed's confinement, plus three tightenings and nothing looser (#240a §5;
# corrected 2026-09-15 in review round 5: this said "strictly more confined"
# while carrying NONE of maknaed's ProtectHostname/RestrictNamespaces/
# RestrictRealtime/SystemCallFilter/SystemCallArchitectures — and DID carry
# MemoryDenyWriteExecute=, which maknaed records as a measured SIGSYS crash-loop
# for aws-lc-fips; the deputy installs that same FIPS provider since #240b).
# A test in bins/maknae-egress/src/main.rs holds every hardening line maknaed's unit carries to
# this one, and refuses the two FIPS-incompatible directives in both. The
# deputy holds a credential and a route out and nothing else: it reads no
# user files, writes no audit (the kernel does), and parses no policy.
#   ProtectHome=yes    — not `read-only`: unlike maknaed (#77's read path) the
#                        deputy has no business in any home directory at all.
#   no ReadWritePaths  — maknaed needs /var/log/maknae for the audit sink; the
#                        deputy writes nothing to disk.
#   RestrictAddressFamilies — below; maknaed does not restrict families.
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute= and SystemCallFilter=~@privileged @resources are
# DELIBERATELY OMITTED, as in maknaed.service: measured there on Rocky 10 /
# systemd 257 (2026-08-17), aws-lc-fips needs W^X memory and @resources
# syscalls for its power-on integrity self-test and either directive raises
# SIGSYS. The deputy is built on the same module and installs it at start;
# #242's enforcing-host run is where this unit is first observed live.
SystemCallFilter=@system-service
SystemCallArchitectures=native
# #240b: the only process with a route out gets exactly the families its two
# legs use — the activation socket and TCP to Vault and the provider.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
