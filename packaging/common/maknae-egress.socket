[Unit]
Description=maknae egress deputy socket
Documentation=https://github.com/darkhonor/maknae

[Socket]
# The init system creates and owns the socket, so the deputy never chgrps it
# and needs no CAP_CHOWN and no supplementary-group membership. `_maknae` is
# the daemon's account: it is the ONLY peer the deputy will speak to, and the
# deputy re-checks that per connection with peer credentials — the mode here
# is defence in depth, not the boundary.
ListenStream=/run/maknae-egress/egress.sock
SocketUser=_maknae-egress
SocketGroup=_maknae
SocketMode=0660
RemoveOnStop=yes
# The directory belongs to the SOCKET unit, which creates the path in it.
# With RuntimeDirectory= on the service instead, stopping the service (a
# crash, a restart) removed the directory out from under the still-listening
# activation socket, and the daemon found no path to connect to until the
# socket unit itself was restarted (critical review of #240). 0751, as
# maknaed.service's own: the daemon connects in here as `_maknae`, which is
# in neither of the deputy's groups, so others may traverse (x) but not list
# — the socket's 0660 _maknae-egress:_maknae above gates the connect. Owned
# by root (this unit has no User=); the deputy never writes here.
#
# Two settings, because they answer different questions. DirectoryMode= is
# THIS unit's own (systemd.socket): the mode of the parent directories systemd
# creates at bind time, 0755 by default — world-listable, which the sentence
# above refuses. RuntimeDirectory= is an exec-context setting; whether a
# socket unit that spawns no process honours it decides only whether the
# directory is also REMOVED when this unit stops. The mode never rests on it.
DirectoryMode=0751
RuntimeDirectory=maknae-egress
RuntimeDirectoryMode=0751

[Install]
WantedBy=sockets.target
