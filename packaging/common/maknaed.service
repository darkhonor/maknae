[Unit]
Description=maknae trust-plane daemon (maknaed)
Documentation=https://github.com/darkhonor/maknae
# #240: ordered AFTER the deputy's socket and service, so that at shutdown —
# units stop in the reverse of their start order — the deputy outlives this
# daemon's handler drain (TimeoutStopSec below): a deputy killed mid-provider-
# call would cut the very exchange the drain waits for. Ordering only, no
# dependency: a host with no provider registered need not have the deputy
# enabled, and an inactive unit imposes no ordering.
After=network-online.target maknae-egress.socket maknae-egress.service
Wants=network-online.target

[Service]
Type=exec
User=_maknae
# Socket-group gate (spec §5.2, Option 1): _maknae must be a member of `maknae` so
# it can chgrp its own UDS to `maknae` WITHOUT CAP_CHOWN (the daemon drops all
# caps). This is the SOLE membership mechanism (no on-disk membership, §5.3).
# Superseded by systemd socket activation, #92.
SupplementaryGroups=maknae
ExecStart=/usr/bin/maknaed
# #240: a permitted session.prompt holds its handler for up to egress.deadline_ms
# (600 s at the configured ceiling) while the provider answers, and the shutdown
# drain waits that long plus 10 s to write the outcome record rather than abort
# a call whose content already left. systemd's default 90 s would SIGKILL that
# wait. The chain at BOTH ceilings (transport timeouts 60 s, egress deadline
# 600 s), walked in execution order: the credential supervisor's abort and reap
# 1 s + the handler drain 801 s (handshake 60 + group lookup 5 + frame read 60
# + PDP decision 5 + provider call 600 + response write 60 + close 1 + a 10 s
# margin for the audit appends) + the reap of what it aborts 1 s + the audit
# drain 5 s + the plane client's shutdown 60 s (a lock wait bounded at 30 s —
# the supervisor is aborted first, so it is free in practice — then revoke-self
# under the same 30 s) + runtime teardown 3 s = 871 s. A SIGKILL inside that
# revoke leaves a live token until its TTL. At the DEFAULTS the same chain is
# 1 + 316 + 1 + 5 + 60 + 3 = 386 s, and a stop with nothing in flight exits in
# milliseconds. Held to the chain, two-sided within 10 s, by a kernel test that
# reads this line (run.rs: the_units_stop_timeouts_cover_the_shutdown_chain_...).
TimeoutStopSec=880
# systemd (root) TPM-decrypts the sealed SecretID into $CREDENTIALS_DIRECTORY
# (0400, _maknae-only, memory-backed). Name pinned: enroll seals
# --name=maknaed-secret-id and the daemon reads $CREDENTIALS_DIRECTORY/maknaed-secret-id.
LoadCredentialEncrypted=maknaed-secret-id:/etc/maknae/private/maknaed-secret-id.cred
RuntimeDirectory=maknae
RuntimeDirectoryMode=0751
# ProtectSystem=strict mounts /var/log read-only; without this the audit sink
# open() gets EROFS and every boot fails closed. Chosen over LogsDirectory=
# (which chowns/chmods at start, colliding with the chattr +a inode).
ReadWritePaths=/var/log/maknae
ProtectSystem=strict
# read-only since #77 (spec D5a, dated 2026-08-28): the read PEP reads the
# enrolled home through a maknae-io anchor under PDP decision; write to any
# home remains forbidden at this layer regardless of DAC/MAC.
ProtectHome=read-only
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute= and SystemCallFilter=~@privileged @resources are
# DELIBERATELY OMITTED (empirically confirmed on Rocky 10 / systemd 257,
# 2026-08-17). Both are seccomp-enforced, and aws-lc-fips (the BoringCrypto FIPS
# module) needs W^X memory and @resources syscalls (mlock of secret material) for
# its power-on integrity self-test — either directive raises SIGSYS (status=31/SYS)
# and crash-loops the daemon. The daemon serves cleanly with @system-service +
# native; the remaining filesystem/namespace/capability hardening above is intact.
# See spec §5 / plan Task 4 Step 3. (A FIPS-compatible syscall allowlist that can
# re-add a tightened filter is future hardening work.)
SystemCallFilter=@system-service
SystemCallArchitectures=native
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maknaed

[Install]
WantedBy=multi-user.target
