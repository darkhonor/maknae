[Unit]
Description=maknae trust-plane daemon (maknaed)
Documentation=https://github.com/darkhonor/maknae
# #240: ordered AFTER the deputy's socket and service, so that at shutdown —
# units stop in the reverse of their start order — the deputy outlives this
# daemon's handler drain (TimeoutStopSec below): a deputy killed mid-provider-
# call would cut the very exchange the drain waits for. Ordering only, no
# dependency: a host with no provider registered need not have the deputy
# enabled, and an inactive unit imposes no ordering.
After=network-online.target maknae-egress.socket maknae-egress.service nss-user-lookup.target systemd-userdbd.socket
Wants=network-online.target systemd-userdbd.socket

[Service]
Type=exec
User=_maknae
# Socket-group gate (spec §5.2, Option 1): _maknae must be a member of `maknae` so
# it can chgrp its own UDS to `maknae` WITHOUT CAP_CHOWN (the daemon drops all
# caps). This is the SOLE membership mechanism (no on-disk membership, §5.3).
# Superseded by systemd socket activation, #92.
# #609: `maknae-agents` likewise lets it chgrp the agent UDS.
SupplementaryGroups=maknae maknae-agents
ExecStart=/usr/bin/maknaed
ExecReload=/usr/bin/kill -HUP $MAINPID
# #240: a permitted session.prompt holds its handler for up to egress.deadline_ms
# (600 s at the configured ceiling) while the provider answers, and the shutdown
# drain waits that long plus 10 s to write the outcome record rather than abort
# a call whose content already left. systemd's default 90 s would SIGKILL that
# wait. The chain at BOTH ceilings (transport timeouts 60 s, egress deadline
# 600 s), walked in execution order: the wait for a reload's turn 5 s + the
# stop record's append 5 s + the
# credential supervisor's abort and reap 1 s + the handler drain 821 s (handshake 60 + session-fact lookup at connect 5 + admission audit append 5 + frame read 60 + session-fact lookup at the request 5 + home resolution 5
# + PDP decision 5 + the verb's own blocking step 5 + provider call 600 +
# response write 60 + close 1 + a 10 s margin for the audit appends) + the reap
# of what it aborts 1 s + the audit drain 5 s + the plane client's shutdown 60 s
# (a lock wait bounded at 30 s — the supervisor is aborted first, so it is free
# in practice — then revoke-self under the same 30 s) + runtime teardown 3 s +
# the diagnostics flush 1 s = 902 s. A SIGKILL inside that revoke leaves a live token until its TTL. At the
# DEFAULTS the same chain is 5 + 5 + 1 + 336 + 1 + 5 + 60 + 3 + 1 = 417 s, and a stop with
# nothing in flight exits in milliseconds.
TimeoutStopSec=902
# systemd (root) TPM-decrypts the sealed SecretID into $CREDENTIALS_DIRECTORY
# (0400, _maknae-only, memory-backed).
LoadCredentialEncrypted=maknaed-secret-id:/etc/maknae/private/maknaed-secret-id.cred
LoadCredentialEncrypted=maknaed-graph-key:/etc/maknae/private/maknaed-graph-key.cred
# #318: the unit's environment is NOT clean by default. DefaultEnvironment=
# (system.conf) and `systemctl set-environment` reach EVERY spawned service, so
# a proxied enterprise estate hands the daemon HTTPS_PROXY as routine practice.
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy VAULT_ADDR VAULT_TOKEN VAULT_SKIP_VERIFY VAULT_CACERT VAULT_CAPATH VAULT_CLIENT_CERT VAULT_CLIENT_KEY VAULT_NAMESPACE SSL_CERT_FILE SSL_CERT_DIR
RuntimeDirectory=maknae maknae-agent
RuntimeDirectoryMode=0751
StateDirectory=maknae maknae/conversations maknae/tasks
StateDirectoryMode=0700
# ProtectSystem=strict mounts /var/log read-only; without this the audit sink
# open() gets EROFS and every boot fails closed. Chosen over LogsDirectory=
# (which chowns/chmods at start, colliding with the chattr +a inode).
ReadWritePaths=/var/log/maknae
ProtectSystem=strict
# read-only: the daemon opens nothing in a home (#365), but each filesystem request resolves
# the requester's home and each attempt stats it, so the path stays visible. Write to any
# home remains forbidden at this layer regardless of DAC/MAC.
ProtectHome=read-only
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute= and SystemCallFilter=~@privileged @resources are
# DELIBERATELY OMITTED (empirically confirmed on Rocky 10 / systemd 257,
# 2026-08-17). Both are seccomp-enforced, and aws-lc-fips (the AWS-LC-FIPS
# module) needs W^X memory and @resources syscalls (mlock of secret material) for
# its power-on integrity self-test — either directive raises SIGSYS (status=31/SYS)
# and crash-loops the daemon. The daemon serves cleanly with @system-service +
# native; the remaining filesystem/namespace/capability hardening above is intact.
# See spec §5 / plan Task 4 Step 3. (A FIPS-compatible syscall allowlist that can
# re-add a tightened filter is future hardening work.)
SystemCallFilter=@system-service
SystemCallArchitectures=native
Restart=on-failure
# A SIGHUP that lands before the handler is registered kills the process, an exit systemd counts as clean.
RestartForceExitStatus=SIGHUP
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maknaed

[Install]
WantedBy=multi-user.target
